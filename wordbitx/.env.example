# Required for CRM authentication and database access
NEXTAUTH_SECRET=
NEXTAUTH_URL=
MONGODB_URI=
# Intake workspace for website contact and demo requests; configure the same ID in the root app environment.
PUBLIC_LEAD_ORGANIZATION_ID=
PUBLIC_LEAD_ALLOWED_ORIGINS=
# Temporary one-time setup secret for the legacy initial administrator endpoint; remove after setup.
INITIAL_ADMIN_SETUP_TOKEN=
# Email allowed to access the platform administrator area.
PLATFORM_SUPER_ADMIN_EMAIL=
# Temporary one-time secret for creating the platform administrator account; remove after setup.
PLATFORM_SUPER_ADMIN_SETUP_TOKEN=
# SMTP delivery for approved workspace owner invites.
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASSWORD=
SMTP_FROM=
APP_URL=

# Required only when enabling Cloudinary uploads
CLOUDINARY_CLOUD_NAME=
CLOUDINARY_API_KEY=
CLOUDINARY_API_SECRET=

# Optional integrations
GEMINI_API_KEY=
